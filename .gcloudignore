# What `gcloud run deploy --source .` uploads to Cloud Build: only what the API image needs.
# Everything else (web app, docs, .env, keys, local data) never leaves this machine.
/*
!/Dockerfile
!/package.json
!/package-lock.json
!/shared/
!/api/
!/web/
/web/*
!/web/package.json

node_modules/
dist/
coverage/
.env
.env.*
*.log
*.tsbuildinfo
*firebase-adminsdk*.json
*service-account*.json
*.pem
*.key
