# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=3000
# mock = generated data for every integration; live = real providers
DATA_MODE=mock
LOG_LEVEL=info

# Local development against the Firebase Emulator Suite (remove both in production)
FIREBASE_PROJECT_ID=demo-agency-hub
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Web API key (Firebase console → Project settings). Any value works with the emulator.
FIREBASE_WEB_API_KEY=demo-key

CORS_ORIGINS=http://localhost:4200

# Shared secret for signed n8n → API webhooks (32+ chars). Used in the ingest phase.
# N8N_SECRET=
