# Copy to .env. Never commit .env.
NODE_ENV=development
PORT=3000
# mock = generated data for every integration; live = real providers
DATA_MODE=mock
LOG_LEVEL=info

# Default: fully local against the Firebase Emulator Suite (npm run start:emulators -w web).
# Real Firebase: set your project ID, comment out both *_EMULATOR_HOST lines and set GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=demo-agency-hub
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Web API key (Firebase console → Project settings). Any value works with the emulator.
FIREBASE_WEB_API_KEY=demo-key

CORS_ORIGINS=http://localhost:4200

# Shared secret for signed n8n → API webhooks (32+ chars). Used in the ingest phase.
# N8N_SECRET=

# Service-account key file for the real Firebase project. Needed when Auth or Firestore is not the emulator.
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/outside/repo/service-account.json

# Google Sheets reader (dedicated service account, no project roles). Agencies share sheets with its email as Viewer.
# Hosted: put the JSON in SHEETS_SERVICE_ACCOUNT_JSON instead.
# SHEETS_SERVICE_ACCOUNT_FILE=C:/path/outside/repo/agency-hub-sheets.json

# Outgoing email for signup verification codes (any SMTP provider: Gmail app password, Resend, SendGrid, Brevo…).
# Without SMTP_HOST, development prints the code to this API console; production refuses to send.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password-here
# MAIL_FROM=Agency Hub <you@example.com>

# HubSpot (CRM widget + customers). Private app token with scopes crm.objects.contacts.read and crm.objects.deals.read.
# When set, the CRM provider uses HubSpot regardless of DATA_MODE.
# HUBSPOT_ACCESS_TOKEN=pat-eu1-...
# Deal pipeline for the dashboard chart (Settings → Objects → Deals → Pipelines). Defaults to the "default" pipeline.
# HUBSPOT_DEAL_PIPELINE_ID=default
