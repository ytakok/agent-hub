rules_version = '2';

// All writes go through the NestJS API (Admin SDK bypasses these rules).
// Clients may only read their own profile and their own tenant's data, scoped by custom claims.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function inTenant(tid) { return signedIn() && request.auth.token.tenantId == tid; }
    function hasRole(roles) { return request.auth.token.role in roles; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /tenants/{tid} {
      allow read: if inTenant(tid);
      allow write: if false;

      // Feature overrides and settings: readable by members so the UI can react live.
      match /config/{doc} {
        allow read: if inTenant(tid);
        allow write: if false;
      }

      // Audit logs, invitations and integration metadata are admin-only.
      match /auditLogs/{id} { allow read: if inTenant(tid) && hasRole(['owner', 'admin']); allow write: if false; }
      match /invitations/{id} { allow read: if inTenant(tid) && hasRole(['owner', 'admin']); allow write: if false; }
      match /integrations/{id} { allow read: if inTenant(tid) && hasRole(['owner', 'admin']); allow write: if false; }

      match /{collection}/{id} {
        allow read: if inTenant(tid)
          && hasRole(['owner', 'admin', 'agent', 'viewer'])
          && !(collection in ['auditLogs', 'invitations', 'integrations']);
        allow write: if false;
      }
    }

    // Global flag definitions are not secret, but clients get resolved flags from the API.
    match /featureFlags/{key} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Username registry is server-only (prevents enumeration).
    match /usernames/{name} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
